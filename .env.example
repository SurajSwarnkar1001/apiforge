# ==========================================
# APIForge Environment Configuration
# ==========================================

# Environment
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Database (MongoDB / MongoDB Atlas)
DATABASE_URL=mongodb://localhost:27017/apiforge_db?directConnection=true

# Redis (BullMQ & Pub/Sub)
REDIS_URL=redis://localhost:6379

# Security & Secrets
JWT_SECRET=super-secret-jwt-key-change-in-production-min-32-chars-length
# 32-byte hexadecimal encryption key for AES-256-GCM (e.g. openssl rand -hex 32)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# SSRF & Target Limits
ALLOW_LOCAL_TARGETS=false
MAX_CONCURRENT_LOAD_TESTS=5
MAX_TEST_DURATION_SECONDS=1800
MAX_VUS_UNVERIFIED=10
MAX_VUS_VERIFIED=10000

# Worker Settings
PLAYWRIGHT_HEADLESS=true
K6_PATH=k6
